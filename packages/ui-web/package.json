  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@homebell/config": "workspace:*",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "typescript": "5.9.3",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "react-dom": "19.3.1",
    "vitest": "5.1.1"
  }
