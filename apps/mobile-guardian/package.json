{
  "name": "@homebell/mobile-guardian",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:check": "expo export --platform android --platform ios --output-dir dist-check"
  },
  "dependencies": {
    "@homebell/api-client": "workspace:*",
    "@homebell/client-services": "workspace:*",
    "@homebell/contracts": "workspace:*",
    "@homebell/copy": "workspace:*",
    "@homebell/design-tokens": "workspace:*",
    "@homebell/mocks": "workspace:*",
    "@tanstack/react-query": "5.108.3",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@homebell/.*|msw|@mswjs/.*|@msw/.*|path-to-regexp|is-node-process|type-fest|statuses|tldts-core|tldts|tough-cookie|cookie|until-async|outvariant|strict-event-emitter|headers-polyfill|graphql|rettime|@open-draft/.*))"
    ],
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist-check/"
    ],
    "transform": {
      "^.+.mjs$": "babel-jest"
    },
    "moduleNameMapper": {
      "^msw$": "<rootDir>/../../packages/mocks/src/msw-lite.ts"
    }
  }
}
