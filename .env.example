# Copy using setup:local on Windows, or supply these from your deployment secret store.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MIGRATION_DATABASE_URL=postgresql://postgres:<admin-password>@127.0.0.1:55432/homebell
IDENTITY_DATABASE_URL=postgresql://hb_identity:<identity-password>@127.0.0.1:55432/homebell
TENANT_DATABASE_URL=postgresql://hb_tenant:<tenant-password>@127.0.0.1:55432/homebell
CONTROL_DATABASE_URL=postgresql://hb_control:<control-password>@127.0.0.1:55432/homebell
REDIS_URL=redis://:<redis-password>@127.0.0.1:56379
REDIS_NAMESPACE=homebell
SIGNING_KEY_PATH=<absolute-private-key-path>
VERIFY_KEY_PATH=<absolute-public-key-path>
SIGNING_KEY_ID=<key-id>
TOKEN_ISSUER=https://homebell.local
CURSOR_SECRET=<at-least-64-random-characters>
OTP_PEPPER=<at-least-64-random-characters>
WEB_ORIGIN=https://localhost:3000
PLATFORM_ORIGIN=https://localhost:3100
# OIDC_PLATFORM_CALLBACK_URL=https://localhost:3100/api/v1/platform-auth/oidc/callback
OIDC_ENABLED=false
# Enable only after configuring the issuer's MFA assurance mapping and TLS.
# OIDC_ISSUER=https://<issuer>
# OIDC_CLIENT_ID=<client-id>
# OIDC_CLIENT_SECRET=<client-secret>
# OIDC_CALLBACK_URL=https://localhost:3000/api/v1/auth/oidc/callback
# OIDC_MFA_ACR=<issuer-specific-required-acr>
# Compose only; setup:local generates these locally.
# LOCAL_POSTGRES_PASSWORD=<admin-password>
# LOCAL_REDIS_PASSWORD=<redis-password>
