{
  "name": "homebell",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsc -p apps/api/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint apps packages scripts",
    "format": "prettier --write apps packages scripts *.json *.yaml .github eslint.config.mjs vitest.config.ts",
    "format:check": "prettier --check apps packages scripts *.json *.yaml .github eslint.config.mjs vitest.config.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "node scripts/migrate.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "start": "node --env-file=.env dist/apps/api/src/main.js",
    "build:web": "next build apps/platform-admin",
    "typecheck:web": "tsc -p apps/platform-admin/tsconfig.json --noEmit",
    "test:browser": "vitest run --project browser",
    "usage:reconcile": "node scripts/reconcile-usage.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "jose": "6.2.12",
    "next": "16.4.0",
    "node-pg-migrate": "9.0.0",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.12.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "6.0.3",
    "eslint": "10.12.0",
    "prettier": "3.8.3",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
