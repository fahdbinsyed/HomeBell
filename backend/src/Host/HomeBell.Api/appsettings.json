{
  "ConnectionStrings": {
    "Database": "",
    "DatabaseOwner": "",
    "Redis": "localhost:6379"
  },
  "Auth": {
    "Issuer": "https://api.homebell.app",
    "Audience": "homebell-api",
    "AccessTokenMinutes": 10
  },
  "Otp": {
    "AllowedCountryCodes": ["+1"],
    "DailyGlobalBudget": 10000
  },
  "Smtp": {
    "OtpDelivery": "none"
  },
  "Terms": {
    "CurrentVersion": "2026-08"
  },
  "RateLimits": {
    "AuthPerMinute": 20
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "FileLogging": {
    "Directory": "Logs",
    "FileName": "%ApplicationName",
    "MinimumLevel": "Info",
    "MaximumFileSizeBytes": 10000000,
    "MaxSizeRollBackups": 10,
    "FrameworkMinimumLevel": "Warning"
  },
  "AllowedHosts": "*"
}
